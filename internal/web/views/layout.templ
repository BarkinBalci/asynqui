package views

import "github.com/BarkinBalci/asynqui/internal/web/views/components"

// Document is the HTML skeleton. data-theme comes from the theme cookie, so
// there is no flash before app.js runs. htmx loads before app.js, which
// configures it before it initialises.
templ Document(d Doc, title templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ d.Theme.Value() } data-refresh={ d.Refresh.Value() } data-base={ d.CookiePath }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="referrer" content="same-origin"/>
			<title>
				@title
				{ "– asynqui" }
			</title>
			<link rel="icon" href={ templ.SafeURL(d.Assets.Icon) } type="image/svg+xml"/>
			<link rel="stylesheet" href={ templ.SafeURL(d.Assets.CSS) }/>
			<script src={ d.Assets.HTMX } defer></script>
			<script src={ d.Assets.JS } defer></script>
		</head>
		<body>
			<a class="skip-link" href={ templ.SafeURL("#" + components.ContentID) }>Skip to content</a>
			{ children... }
		</body>
	</html>
}

// Page is the app shell: sidebar, top bar and the page content.
templ Page(l Layout, title templ.Component) {
	@Document(l.Doc, title) {
		<div class="app">
			@components.SidebarNav(l.Sidebar)
			<div class="main">
				@components.TopBarView(l.TopBar)
				<main class="content" id={ components.ContentID } tabindex="-1">
					{ children... }
				</main>
			</div>
		</div>
		@components.ToastRegion(l.Toasts)
	}
}
