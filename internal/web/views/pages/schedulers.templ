package pages

import (
	"github.com/BarkinBalci/asynqui/internal/web/format"
	"github.com/BarkinBalci/asynqui/internal/web/views"
	"github.com/BarkinBalci/asynqui/internal/web/views/components"
)

// SchedulersPage is the Schedulers page: a read-only table of the entries
// of the connection's running schedulers. See Live for requests and
// polling; the filter input sits outside the polled table.
templ SchedulersPage(m Schedulers) {
	@views.Page(m.Layout, lastCrumb(m.Layout)) {
		<div id={ SchedulersPageID } class="content-region" hx-sync="this:queue last">
			@livePoll(m.Live, false)
			<div class="page-head">
				<h1 class="h1">
					@components.SectionName(components.SectionSchedulers, false)
				</h1>
			</div>
			@liveBanner(m.Live, entriesFailed(), false)
			<section class="card tbl-card" aria-label="Scheduler entries">
				<div class="tbar">
					@components.FilterInput(SchedulersFilter, SchedulersRowsID, "Filter entries")
				</div>
				@schedulersTable(m, false)
			</section>
		</div>
	}
}

// SchedulersPoll answers a poll or a sort, out of band.
templ SchedulersPoll(m Schedulers) {
	@livePoll(m.Live, true)
	@liveBanner(m.Live, entriesFailed(), true)
	if !m.Live.Keep {
		@schedulersTable(m, true)
	}
	@liveTail(m.Layout)
}

templ schedulersTable(m Schedulers, oob bool) {
	<div id={ SchedulersTable } { components.OOB(oob)... }>
		@liveData(m.Live, entriesFailed()) {
			@components.Table("schedulers") {
				<thead>
					<tr>
						@components.SortHeader(m.Heads[EntColID]) {
							Entry ID
						}
						@components.SortHeader(m.Heads[EntColSpec]) {
							Spec
						}
						@components.SortHeader(m.Heads[EntColType]) {
							Task type
						}
						@components.PlainHeader(false) {
							Payload
						}
						@components.PlainHeader(false) {
							Options
						}
						@components.SortHeader(m.Heads[EntColNext]) {
							Next run
						}
						@components.SortHeader(m.Heads[EntColPrev]) {
							Last run
						}
					</tr>
				</thead>
				<tbody id={ SchedulersRowsID }>
					if len(m.Rows) == 0 {
						@components.EmptyRow(7) {
							No scheduler entries
						}
					}
					for _, r := range m.Rows {
						<tr data-filter-text={ r.ID + " " + r.Spec + " " + r.TaskType }>
							<td><a id={ r.LinkID } class="row-link mono" href={ templ.SafeURL(r.URL) } title={ r.ID }>{ r.ShortID }</a></td>
							<td class="mono">{ r.Spec }</td>
							<td class="c-type">{ r.TaskType }</td>
							<td class="mono c-payload cell-trunc" title={ r.PayloadTitle }>{ r.Payload }</td>
							<td>
								@optionTokens(r.Options)
							</td>
							<td>
								@components.TimeOrDash(r.Next)
							</td>
							<td class="muted">
								@components.TimeOrDash(r.Prev)
							</td>
						</tr>
					}
				</tbody>
			}
		}
	</div>
}

// SchedulerEntryPage is the Scheduler entry page: the entry's details,
// payload and enqueue history. The heading and the payload card are
// rendered once; polls replace the history and the details (see
// SchedulerEntry.Whole). The history's page links are user requests.
templ SchedulerEntryPage(m SchedulerEntry) {
	@views.Page(m.Layout, lastCrumb(m.Layout)) {
		<div id={ EntryPageID } class="content-region" hx-sync="this:queue last">
			@livePoll(m.Live, false)
			@backLink("back-schedulers", m.SchedulersURL, components.SectionSchedulers)
			@liveBanner(m.Live, entriesFailed(), false)
			@entryBody(m, false)
		</div>
	}
}

// SchedulerEntryPoll answers a poll or a page change, out of band.
templ SchedulerEntryPoll(m SchedulerEntry) {
	@livePoll(m.Live, true)
	@liveBanner(m.Live, entriesFailed(), true)
	if !m.Live.Keep {
		if m.Whole {
			@entryBody(m, true)
		} else {
			@entryHistory(m.History, true)
			@entryDetails(m, true)
		}
	}
	@liveTail(m.Layout)
}

// EntryNotFound is the heading of a stale or unknown entry.
templ EntryNotFound() {
	Entry not found
}

templ entryBody(m SchedulerEntry, oob bool) {
	@liveBody(EntryBodyID, m.Live, m.Found, lastCrumb(m.Layout), EntryNotFound(), entriesFailed(), oob) {
		<div class="detail-head">
			<h1 class="h1">{ m.TaskType }</h1>
			<div class="detail-id">
				<span class="mono">{ m.ID }</span>
				@components.CopyIDButton(CopyIDButtonID, m.ID)
			</div>
		</div>
		<div class="detail-cols">
			<div class="detail-main detail-stack">
				@payloadCard(m)
				@entryHistory(m.History, false)
			</div>
			@entryDetails(m, false)
		</div>
	}
}

// payloadCard is the payload with the JSON/Raw toggle: plain links
// (?payload=raw), so it works without JS. It is not polled.
templ payloadCard(m SchedulerEntry) {
	<section class="card" aria-labelledby="payload-title">
		<div class="cardhead">
			<h2 class="card-title" id="payload-title">Payload</h2>
			if m.PayloadJSON {
				<nav class="seg" aria-label="Payload view">
					<a id="payload-json" href={ templ.SafeURL(m.JSONURL) } { toggleAttrs(!m.Raw)... }>JSON</a>
					<a id="payload-raw" href={ templ.SafeURL(m.RawURL) } { toggleAttrs(m.Raw)... }>Raw</a>
				</nav>
			}
		</div>
		if m.NoPayload {
			<p class="empty">No payload</p>
		} else {
			@components.CodeBlock(PayloadID, m.Payload, "Payload", "Copy payload")
		}
	</section>
}

// toggleAttrs mark the current view of a two-link toggle.
func toggleAttrs(on bool) templ.Attributes {
	if on {
		return templ.Attributes{"class": "on", "aria-current": "true"}
	}
	return nil
}

templ entryHistory(h History, oob bool) {
	<section id={ EntryHistoryID } class="card" aria-labelledby="history-title" { components.OOB(oob)... }>
		<div class="cardhead">
			<h2 class="card-title" id="history-title">Enqueue history</h2>
			@historyPager(h)
		</div>
		@historyTable(h)
	</section>
}

templ historyFailed() {
	Could not load enqueue history
}

templ entryDetails(m SchedulerEntry, oob bool) {
	<section id={ EntryDetailsID } class="card detail-side" aria-labelledby="details-title" { components.OOB(oob)... }>
		<div class="cardhead">
			<h2 class="card-title" id="details-title">Details</h2>
		</div>
		<dl class="dl">
			<dt>Spec</dt>
			<dd class="mono">{ m.Spec }</dd>
			<dt>Queue</dt>
			<dd>
				if m.Queue == "" {
					<span class="muted">—</span>
				} else {
					<a id="entry-queue" href={ templ.SafeURL(m.QueueURL) }>{ m.Queue }</a>
				}
			</dd>
			<dt>Options</dt>
			<dd>
				if len(m.Options) == 0 {
					<span class="muted">—</span>
				} else {
					@optionTokens(m.Options)
				}
			</dd>
			<dt>Next run</dt>
			<dd>
				@runTime(m.Next, m.Now)
			</dd>
			<dt>Last run</dt>
			<dd>
				@runTime(m.Prev, m.Now)
			</dd>
		</dl>
	</section>
}

// historyPager is "21–40" with ‹ and ›; asynq gives no total.
templ historyPager(h History) {
	if h.State == DataReady && (h.PrevURL != "" || h.NextURL != "") {
		<nav class="pager" aria-label="Enqueue history pages">
			if h.To > 0 {
				<span class="muted num">{ format.Number(h.From) }–{ format.Number(h.To) }</span>
			}
			@pageLink("hist-prev", h.PrevURL, "Newer") {
				‹
			}
			@pageLink("hist-next", h.NextURL, "Older") {
				›
			}
		</nav>
	}
}

// pageLink is a pager arrow: a link that fetches the page with htmx, or a
// disabled-looking span at either end.
templ pageLink(id, url, label string) {
	if url == "" {
		<span class="pager-btn" aria-disabled="true" aria-label={ label }>
			{ children... }
		</span>
	} else {
		<a id={ id } class="pager-btn" href={ templ.SafeURL(url) } hx-get={ url } hx-swap="none" hx-push-url="true" aria-label={ label } title={ label }>
			{ children... }
		</a>
	}
}

templ historyTable(h History) {
	switch h.State {
		case DataFailed:
			@errorBox(historyFailed(), h.Error)
		case DataChecking:
			<p class="checking">Checking</p>
		default:
			@components.Table("history") {
				<thead>
					<tr>
						@components.PlainHeader(false) {
							Enqueued at
						}
						@components.PlainHeader(false) {
							Task ID
						}
					</tr>
				</thead>
				<tbody>
					if len(h.Events) == 0 {
						@components.EmptyRow(2) {
							No enqueue events
						}
					}
					for _, e := range h.Events {
						<tr>
							<td>
								@components.TimeAbs(e.EnqueuedAt)
							</td>
							<td>
								if e.TaskURL != "" {
									<a id={ e.LinkID } class="mono" href={ templ.SafeURL(e.TaskURL) } title={ e.TaskID }>{ e.ShortID }</a>
								} else {
									<span class="mono muted" title={ e.TaskID }>{ e.ShortID }</span>
								}
							</td>
						</tr>
					}
				</tbody>
			}
	}
}
