package components

// Icons are inline stroke SVGs on a 24 viewBox with stroke 2, round caps
// and joins, in currentColor (style guide). They are decorative: the
// surrounding control carries the accessible name.
templ icon(size string) {
	<svg class="icon" width={ size } height={ size } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		{ children... }
	</svg>
}

templ IconOverview(size string) {
	@icon(size) {
		<rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect>
	}
}

templ IconQueues(size string) {
	@icon(size) {
		<path d="M12 3l9 5-9 5-9-5 9-5z"></path><path d="M3 13l9 5 9-5"></path>
	}
}

templ IconServers(size string) {
	@icon(size) {
		<rect x="3" y="4" width="18" height="7" rx="2"></rect><rect x="3" y="13" width="18" height="7" rx="2"></rect><path d="M7 7.5h.01M7 16.5h.01"></path>
	}
}

templ IconSchedulers(size string) {
	@icon(size) {
		<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>
	}
}

templ IconDatabase(size string) {
	@icon(size) {
		<ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"></path>
	}
}

