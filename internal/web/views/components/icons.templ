// Logo is the stacked-cards mark. Its fills come from CSS classes, so it
// follows the theme without inline styles.
templ Logo(size string) {
	<svg class="icon logo" width={ size } height={ size } viewBox="0 0 48 48" aria-hidden="true" focusable="false">
		<rect class="logo-back" x="5" y="13" width="22" height="27" rx="4" transform="rotate(-14 16 26.5)"></rect>
		<rect class="logo-mid" x="13" y="10.5" width="22" height="27" rx="4" transform="rotate(-3 24 24)"></rect>
		<rect class="logo-front" x="21" y="8" width="22" height="27" rx="4" transform="rotate(9 32 21.5)"></rect>
		<path class="logo-glyph" d="M28.5 16C26.5 16 26.5 17 26.5 18.5V20C26.5 21 25.8 21.5 25 21.5C25.8 21.5 26.5 22 26.5 23V24.5C26.5 26 26.5 27 28.5 27M35.5 16C37.5 16 37.5 17 37.5 18.5V20C37.5 21 38.2 21.5 39 21.5C38.2 21.5 37.5 22 37.5 23V24.5C37.5 26 37.5 27 35.5 27" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" fill="none" transform="rotate(9 32 21.5)"></path>
	</svg>
}

// Wordmark is "asynq" plus the accent "ui", one span so there is no gap.
templ Wordmark() {
	<span>asynq<span class="wordmark-ui">ui</span></span>
}
