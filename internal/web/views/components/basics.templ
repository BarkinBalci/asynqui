package components

import (
	"time"

	"github.com/BarkinBalci/asynqui/internal/web/format"
)

// Time renders t as <time datetime> with the absolute UTC text; app.js
// rewrites it to relative local text with the absolute time in title.
templ Time(t time.Time) {
	<time datetime={ format.TimeAttr(t) }>{ format.TimeText(t) }</time>
}

// TimeID is Time with an element id. With oob it replaces the element of
// the same id when it arrives in an htmx response.
templ TimeID(id string, t time.Time, oob bool) {
	<time id={ id } datetime={ format.TimeAttr(t) } { OOB(oob)... }>{ format.TimeText(t) }</time>
}

// StatusDot is a connection's health dot, with its state as text for
// screen readers. Unknown is a muted dot.
templ StatusDot(h Health) {
	switch h {
		case HealthUp:
			<span class="dot dot-up" title="Reachable"><span class="sr-only">Reachable</span></span>
		case HealthDown:
			<span class="dot dot-down" title="Unreachable"><span class="sr-only">Unreachable</span></span>
		default:
			<span class="dot dot-unknown" title="Checking"><span class="sr-only">Checking</span></span>
	}
}

// HealthBadge is the Healthy or Unreachable badge; unknown has none.
templ HealthBadge(h Health) {
	switch h {
		case HealthUp:
			<span class="badge badge-ok"><span class="dot"></span>Healthy</span>
		case HealthDown:
			<span class="badge badge-danger"><span class="dot"></span>Unreachable</span>
	}
}

// UnreachableBadge is the Overview heading's "N unreachable" badge. Its
// wrapper is always rendered, empty when n is 0, so polling can replace it.
templ UnreachableBadge(n int, oob bool) {
	<span id={ UnreachableID } { OOB(oob)... }>
		if n > 0 {
			<span class="badge badge-danger"><span class="dot"></span>{ format.Number(int64(n)) } unreachable</span>
		}
	</span>
}

// RoleName is the role as shown in chips and the account menu.
templ RoleName(r Role) {
	switch r {
		case RoleViewer:
			viewer
		case RoleOperator:
			operator
		case RoleAdmin:
			admin
	}
}

// SectionName is the one place a section's label is written: sidebar,
// breadcrumbs, headings and document titles all render it.
templ SectionName(s Section, valkey bool) {
	switch s {
		case SectionOverview:
			Overview
		case SectionQueues:
			Queues
		case SectionServers:
			Servers
		case SectionSchedulers:
			Schedulers
		case SectionInfo:
			if valkey {
				Valkey info
			} else {
				Redis info
			}
	}
}

// CrumbLabel renders a breadcrumb's text.
templ CrumbLabel(c Crumb) {
	if c.Label != nil {
		@c.Label
	} else if c.Section != SectionNone {
		@SectionName(c.Section, c.Valkey)
	} else {
		{ c.Text }
	}
}

// OOB marks an element for an htmx out-of-band swap by id.
func OOB(oob bool) templ.Attributes {
	if oob {
		return templ.Attributes{"hx-swap-oob": "true"}
	}
	return nil
}
